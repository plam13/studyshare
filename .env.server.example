# Server-side only — used by scripts/ (seed, admin tools). Copy to .env.server.local.
# NEVER commit the real file and NEVER prefix these with VITE_ (that would expose them to the browser).
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SECRET_KEY=<secret-or-service-role-key>
# Safety guard: scripts refuse to run against any other project
SEED_EXPECTED_PROJECT_REF=<your-project-ref>
